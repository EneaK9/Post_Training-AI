# Copy to .env for local development. Never commit .env.

# Postgres (local docker compose). For Neon use the DIRECT endpoint (not -pooler) for the
# backend, worker, and migrations; keep sslmode=require.
DATABASE_URL=postgresql+asyncpg://outlier:outlier@127.0.0.1:5433/outlier
TEST_DATABASE_URL=postgresql+asyncpg://outlier:outlier@127.0.0.1:5433/outlier_test

# Safety. Anything other than the literal string "false" is treated as dry run.
DRY_RUN=true

# Config
CONFIG_PATH=config/config.yaml

# Secrets (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=
PII_HMAC_KEY=change-me-in-prod

# Object storage (MinIO locally). Leave S3_ENDPOINT empty and STORAGE_BACKEND=local to use ./.storage
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=outlier-ai
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=us-east-1

# LLM API (Phase 2)
ANTHROPIC_API_KEY=

# Meta Marketing API (Phase 4). Tokens are stored encrypted in the ad_accounts table,
# these are only for the sandbox/contract tests.
META_APP_ID=
META_APP_SECRET=
META_SANDBOX_TOKEN=
